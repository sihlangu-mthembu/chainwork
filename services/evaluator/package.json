  },
  "dependencies": {
    "@chainwork/checks": "workspace:*",
    "@chainwork/sdk": "workspace:*",
    "@chainwork/service-kit": "workspace:*",
    "@chainwork/types": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "tsx": "4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
