# Chainwork environment template.
#
# Copy to .env (git-ignored) and fill in. NEVER commit a real key, mnemonic or password:
# .gitignore ignores .env, .env.* (except this file), .keys/ and *.keystore.
#
# Ground rules
#  - NETWORK=local (anvil, chain 31337) or NETWORK=aevum (Aevum testnet, chain 44005).
#  - Anvil's publicly-known development keys are used as a fallback ONLY when NETWORK=local.
#    On Aevum every key must come from an encrypted V3 keystore plus a password supplied at runtime.
#  - A ROLE_PK variable is accepted by packages/sdk/scripts/env.ts only when NETWORK=local (tests).
#    services/kit reads RELAYER_PK on any network, because a deployment may keep its relayer key in a
#    secrets manager instead of a keystore.
#  - Amounts are tUSD8 base units (6 decimals): 0.10 tUSD8 = 100000.
#  - Chain facts (RPC, chain id) come from docs/CONTEXT.md; do not invent values here.

# =============================================================================
# 1. Chain and deployment (every service, script and agent)
# =============================================================================

# local | aevum
NETWORK=local

# JSON-RPC endpoint. Leave empty to use the default for NETWORK:
# local -> http://127.0.0.1:8545, aevum -> https://rpc-test.qday.info
RPC_URL=

# Path to the deployment file written by contracts/script/Deploy.s.sol.
# Leave empty to use deployments/<NETWORK>.json.
DEPLOYMENT=

# Base URL of the x402 escrow facilitator (services/facilitator).
FACILITATOR_URL=http://127.0.0.1:3402

# Directory holding encrypted keystores loaded by packages/sdk/scripts/env.ts.
# Leave empty to use <repo>/.keys (git-ignored).
KEYSTORE_DIR=

# Password that unlocks the keystores. Supply it at runtime (prompt, OS keychain or secrets
# manager); never write the real value here.
CHAINWORK_KEYSTORE_PASSWORD=replace-with-your-keystore-password

# "1" enables the chain-dependent test suites (SDK end-to-end, facilitator). Off by default so
# the test command stays green without anvil.
CHAINWORK_LOCAL=

# =============================================================================
# 2. Relayer (services/facilitator; any service that sends transactions)
#    Priority in services/kit: RELAYER_PK -> RELAYER_KEYSTORE + password -> anvil key (local only).
#    The relayer pays gas only. It never holds tUSD8.
# =============================================================================

# Encrypted V3 keystore for the relayer, e.g. .keys/deployer (do not commit it).
RELAYER_KEYSTORE=

# Password for RELAYER_KEYSTORE. Falls back to CHAINWORK_KEYSTORE_PASSWORD when empty.
RELAYER_KEYSTORE_PASSWORD=

# Raw relayer private key, for a secrets manager only. Leave empty when using a keystore.
# Placeholder shape: 0x followed by 64 hex characters — never a real key in this file.
RELAYER_PK=

# =============================================================================
# 3. Facilitator HTTP surface and storage (services/facilitator)
# =============================================================================

# Bind address and port. PORT defaults to 3402; FACILITATOR_PORT is accepted as an alias.
HOST=0.0.0.0
PORT=3402
FACILITATOR_PORT=

# Directory for service state. FACILITATOR_DB defaults to <DATA_DIR>/facilitator.sqlite.
DATA_DIR=./data
FACILITATOR_DB=

# =============================================================================
# 4. Operator scripts (packages/sdk/scripts)
# =============================================================================

# gate1.ts: job budget in tUSD8 (default 0.01) and challenge window in seconds (default 30).
BUDGET=0.01
WINDOW=30

# fund-wallets.ts: tQDAY sent to each role for gas (default 0.1), and a preview switch.
GAS_EACH=0.1
DRY_RUN=

# Deploy (contracts/script/Deploy.s.sol:DeployAevum, read by forge): owner of the client
# AgentAccount. This is a public address, not a secret.
ACCOUNT_OWNER=

# Role keys for the local chain only (see the ground rules above). On Aevum, use keystores in
# KEYSTORE_DIR named deployer, client, coordinator, specialist_data, specialist_bad, backup,
# watcher, evaluator. All values below are empty on purpose.
DEPLOYER_PK=
CLIENT_PK=
COORDINATOR_PK=
SPECIALIST_DATA_PK=
SPECIALIST_BAD_PK=
BACKUP_PK=
WATCHER_PK=
EVALUATOR_PK=

# =============================================================================
# 5. Test and debug switches
# =============================================================================

# "1" logs every facilitator request/response body in the test output.
FAC_LOG=

# =============================================================================
# 6. PLANNED components — names reserved, code not in this tree yet
#    (services/indexer T3.2, services/watcher T3.3, services/evaluator T3.4,
#     services/worker-kit T3.5, apps/agents T4.x, apps/dashboard T5.x)
#    These variables are the proposed contract: when the code lands it must read exactly these
#    names, or this file and README.md are updated in the same commit.
# =============================================================================

# --- indexer (T3.2): escrow events in 500-block chunks into SQLite, GET /events?jobId=
INDEXER_PORT=3403
INDEXER_DB=
INDEXER_START_BLOCK=

# --- watcher (T3.3): re-checks Submitted jobs and challenges bad output before the window ends
WATCHER_PORT=3404
WATCHER_DB=
# Where the watcher fetches GET /jobs/<id>/output from. One URL per worker, comma-separated.
WORKER_URL=http://127.0.0.1:3405

# --- evaluator (T3.4): resolves challenged jobs, signs complete/reject, logs its reasoning
EVALUATOR_PORT=3406
EVALUATOR_DB=
EVALUATOR_LOG=./data/evaluator.log

# --- worker kit (T3.5): 402 quote -> PAYMENT-SIGNATURE -> acceptJob -> output endpoint
WORKER_HOST=0.0.0.0
WORKER_PORT=3405
WORKER_DATA_DIR=./data/worker

# --- agents (T4.x): LLM tool loop, deterministic replay of decisions, real chain transactions
# Provider and model id are deployment choices, not chain facts.
AGENTS_LLM_PROVIDER=
AGENTS_LLM_MODEL=
AGENTS_LLM_API_KEY=
# "record" records LLM decisions, "1" replays them (real transactions still run)
AGENTS_REPLAY=
AGENTS_REPLAY_DIR=./apps/agents/replay
AGENTS_LOG_DIR=./data/agents

# --- dashboard (T5.x): Vite build-time variables. Public values only: never put a key here,
#     everything prefixed VITE_ ends up in the browser bundle.
VITE_NETWORK=local
VITE_RPC_URL=http://127.0.0.1:8545
VITE_EXPLORER_URL=https://explorer-test.qday.info
VITE_CHAIN_ID=31337
VITE_FACILITATOR_URL=http://127.0.0.1:3402
VITE_INDEXER_URL=http://127.0.0.1:3403
VITE_TOKEN_ADDRESS=
VITE_ESCROW_ADDRESS=
VITE_REPUTATION_ADDRESS=
VITE_BUDGET_GUARD_ADDRESS=
VITE_WALLETCONNECT_PROJECT_ID=
