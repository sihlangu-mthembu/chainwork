# Dashboard configuration. Copy to .env (gitignored) and fill in the deployment you want to watch.
# Every value is optional: unset addresses render a setup card instead of a broken page, and an
# explicit env value always wins over /deployment.json.

# Chain (defaults to Aevum testnet, chain 44005, from @chainwork/types)
VITE_CHAIN_ID=44005
VITE_RPC_URL=https://rpc-test.qday.info
VITE_EXPLORER_URL=https://explorer-test.qday.info

# Chainwork deployment (see deployments/aevum.json after Deploy.s.sol)
VITE_ESCROW=
VITE_REPUTATION=
VITE_BUDGET_GUARD=
VITE_CLIENT_ACCOUNT=
# tUSD8 proxy on Aevum; leave empty to use the address from @chainwork/types
VITE_TOKEN=

# First block to scan for receipts. Required for receipts: the escrow's deployment block.
VITE_FROM_BLOCK=

# Optional services
VITE_FACILITATOR_URL=
VITE_INDEXER_URL=

# Local chain example (anvil + DeployLocal):
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_EXPLORER_URL=http://127.0.0.1:8545
# VITE_ESCROW=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6
# VITE_REPUTATION=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853
# VITE_BUDGET_GUARD=0x610178dA211FEF7D417bC0e6FeD39F05609AD788
# VITE_CLIENT_ACCOUNT=0x0DCd1Bf9A1b36cE34237eEaFef220932846BCD82
# VITE_TOKEN=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# VITE_FROM_BLOCK=0
